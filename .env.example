# NovaTitre — variables d'environnement nécessaires.
#
# NOMS SEULEMENT. Ne jamais écrire une vraie valeur dans ce fichier :
# il est dans Git. Les valeurs se mettent dans Vercel
# (projet → Settings → Environment Variables), pour Preview et Production.
# En local, copier ce fichier en .env.local (ignoré par Git).

# --- Comptes (Supabase) ---
# Adresse du projet et clé « anon » : publiques par conception, protégées
# par les règles RLS de Supabase. Envoyées au navigateur par /api/config.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clé « service_role » : SECRÈTE, serveur uniquement (lecture de l'offre,
# compteur du coach). Jamais dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Nova Coach (Anthropic) ---
# SECRÈTE, serveur uniquement. Le modèle est fixé dans api/coach.js.
ANTHROPIC_API_KEY=

# --- Paiement (Stripe) ---
# MODE TEST UNIQUEMENT : la clé doit commencer par sk_test_ (ou rk_test_).
# Une clé réelle est refusée par le code (api/stripe/_stripe.js).
STRIPE_SECRET_KEY=
# Secret du webhook (whsec_…), propre à chaque adresse de webhook.
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix de l'offre Premium (price_…), créés en mode test.
STRIPE_PRICE_PREMIUM_MENSUEL=
STRIPE_PRICE_PREMIUM_ANNUEL=

# --- Site ---
# Adresse publique, utilisée pour les retours de paiement Stripe.
# Par défaut : https://novatitre.com
NEXT_PUBLIC_SITE_URL=
