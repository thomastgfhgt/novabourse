{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/catalog.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/api/stripe/webbook",
      "destination": "/api/stripe/webhook",
      "permanent": true
    }
  ],
  "functions": {
    "api/market/extra.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "comment": "NovaBot V7 phase 2 (2026-10-12) : cycle autonome côté serveur, sorties stop-loss/take-profit uniquement (v1, voir api/market/_novabotEngine.js). Hobby plan = 1 déclenchement/jour max ; ajuster si le plan change.",
      "path": "/api/market/extra?kind=novabot-cron",
      "schedule": "0 7 * * *"
    }
  ]
}
